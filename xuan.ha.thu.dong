<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#d7e4f2">
<title>Xuân Hạ Thu Đông</title>
<style>
:root{
  --bg:#d7e4f2; --paper:#f7f0e6; --paper2:#fbf8f1; --line:#2f2a28; --soft:#e7decd;
  --text:#2f2a28; --muted:#6b635d; --gold:#d7b24e; --gold2:#ba9540; --wood:#5b3827; --wood2:#3c2418;
  --accent:#334f8a; --green:#809b7a; --red:#c66767; --shadow:0 10px 28px rgba(41,29,24,.16);
  font-family:"Trebuchet MS",Arial,sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text)}
body{display:flex;justify-content:center;padding:10px}
button,input,select{font:inherit}
button{border:0;background:none;cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}
.hidden{display:none!important}
#app{width:min(100%,430px);min-height:100vh;background:linear-gradient(#d7e4f2 0 280px, #eadfce 280px 100%);border-radius:28px;overflow:hidden;box-shadow:0 18px 46px rgba(28,24,21,.22);border:2px solid rgba(255,255,255,.5);position:relative}
.intro{position:absolute;inset:0;z-index:40;color:#fff;display:flex;align-items:flex-end;justify-content:center}
.intro img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.intro:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(50,28,48,.1),rgba(54,31,39,.52));}
.intro-card{position:relative;margin:18px;padding:18px;background:rgba(255,247,236,.16);border:1px solid rgba(255,255,255,.24);backdrop-filter:blur(9px);border-radius:22px;box-shadow:0 12px 30px rgba(16,8,14,.25)}
.intro-card h1{margin:0 0 8px;font:normal 38px/1 Georgia,serif;color:#fff7e8}
.intro-card p{margin:0 0 14px;line-height:1.55;color:#f9ecdf;font-size:14px}
.stack{display:grid;gap:10px}
.primary,.soft,.gold,.ghost,.danger{min-height:46px;border-radius:14px;padding:12px 14px;font-weight:800}
.primary{background:#fff8ee;color:#684636;border:2px solid #dbc5af;box-shadow:0 3px 0 #cfb399}
.soft{background:#f5ede0;color:#6d5544;border:2px solid #d9c4aa;box-shadow:0 3px 0 #ceb79c}
.gold{background:linear-gradient(#e0bf64,#d2ab4e);color:#47331e;border:2px solid #b18c36;box-shadow:0 3px 0 #92722b}
.ghost{background:rgba(255,255,255,.12);color:#fff8eb;border:1px solid rgba(255,255,255,.4)}
.danger{background:#b86767;color:#fff8f8;border:2px solid #8f4c4c;box-shadow:0 3px 0 #7a3f3f}
.top{padding:12px 12px 8px;position:relative;z-index:2}
.status-row{display:grid;grid-template-columns:1.25fr 1fr 0.72fr auto;gap:8px;align-items:center}
.box{background:#fffaf1;border:2px solid var(--line);border-radius:6px;box-shadow:0 2px 0 rgba(0,0,0,.08);min-height:42px;padding:8px 10px;display:flex;align-items:center;gap:8px}
.box.blue{background:#47639f;color:#fffbe8;border-color:#223a65}.box.red{background:#fffaf1}.box strong{font-size:14px}.box small{display:block;font-size:10px;color:inherit;opacity:.75}
.icon-round{width:44px;height:44px;border-radius:50%;background:#fffaf1;border:2px solid var(--line);display:grid;place-items:center;font-size:20px;position:relative;box-shadow:0 2px 0 rgba(0,0,0,.08)}
.badge-dot{position:absolute;top:5px;right:5px;width:10px;height:10px;border-radius:50%;background:#de685f;border:2px solid #fff}
.city-btn{margin-top:10px;display:flex;justify-content:space-between;gap:8px}.city-btn .box{flex:1;justify-content:center;font-weight:700}
.scene{position:relative;height:335px;overflow:hidden}
.scene-bg{position:absolute;inset:0;background:url('./town_art.png') center/cover no-repeat;filter:saturate(.92) brightness(1.02)}
.scene-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,0) 30%,rgba(255,255,255,.06));}
.season-wash.spring{background:linear-gradient(180deg,rgba(253,218,233,.28),rgba(255,255,255,0) 36%)}
.season-wash.summer{background:linear-gradient(180deg,rgba(254,238,165,.24),rgba(255,255,255,0) 36%)}
.season-wash.autumn{background:linear-gradient(180deg,rgba(238,202,141,.27),rgba(255,255,255,0) 36%)}
.season-wash.winter{background:linear-gradient(180deg,rgba(199,215,238,.31),rgba(255,255,255,0) 36%)}
.floaters{position:absolute;inset:0;pointer-events:none;overflow:hidden}.floater{position:absolute;top:-10%;font-size:14px;animation:fall linear infinite;opacity:.8}.spring .floater,.summer .floater{color:#eba6c4}.autumn .floater{color:#d7a767}.winter .floater{color:#fff}
@keyframes fall{from{transform:translateY(-10%) translateX(0) rotate(0)}to{transform:translateY(115%) translateX(26px) rotate(220deg)}}
.stage-pill{position:absolute;left:12px;top:10px;background:rgba(255,250,240,.92);border:2px solid var(--line);border-radius:8px;padding:8px 10px;font-size:11px;line-height:1.3;max-width:54%}
.stage-pill.right{left:auto;right:12px;max-width:38%;text-align:right}.stage-pill strong{display:block;font-size:12px}
.truck-zone{position:absolute;left:0;right:0;bottom:36px;height:140px}
#truckSvg{position:absolute;left:90px;right:44px;bottom:0;height:126px}
.walk-layer{position:absolute;inset:0;pointer-events:none}
.customer{position:absolute;width:44px;height:92px;pointer-events:auto;cursor:pointer;transition:transform .1s}.customer .tap{position:absolute;inset:-8px}.customer.browse{animation:breathe 1.4s infinite ease-in-out}.customer .hint{position:absolute;bottom:96px;left:-24px;background:rgba(255,250,241,.96);border:2px solid var(--line);border-radius:10px;padding:4px 7px;font-size:10px;min-width:82px;text-align:center;box-shadow:0 4px 12px rgba(52,39,34,.12)}
@keyframes breathe{50%{transform:translateY(-2px)}}
.toast{position:absolute;left:50%;transform:translateX(-50%);bottom:8px;background:rgba(255,249,240,.97);border:2px solid var(--line);border-radius:12px;padding:8px 11px;font-size:12px;box-shadow:0 4px 14px rgba(60,46,38,.12);z-index:10;max-width:90%;text-align:center}
.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:0;background:#e9dfd0;border-top:2px solid rgba(0,0,0,.08);margin-top:-2px}
.tab{padding:14px 6px 12px;text-align:center;border-right:1px solid rgba(0,0,0,.12);color:#3a312d;background:#efe5d6;font-size:12px;font-weight:700}
.tab:last-child{border-right:0}.tab.active{background:#f9f2e6;box-shadow:inset 0 -3px 0 #d8b757}.tab .ico{display:block;font-size:16px;margin-bottom:4px}
.panel{background:rgba(248,241,230,.95);min-height:412px;padding:12px;border-top:2px solid rgba(0,0,0,.08)}
.subhead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}.subhead h2{margin:0;font:normal 17px Georgia,serif}.chips{display:flex;gap:8px;flex-wrap:wrap}.chip{background:#fffaf1;border:2px solid var(--line);border-radius:10px;padding:6px 10px;font-size:12px;font-weight:700}
.shelf-box{background:#fffdfa;border:2px solid var(--line);border-radius:10px;padding:10px;margin-bottom:10px}
.shelf-wood{height:230px;border-radius:10px;border:2px solid #2a1c15;background:linear-gradient(#5d3828,#4f3124);padding:14px 10px 10px;position:relative;overflow:hidden}
.shelf-wood:before,.shelf-wood:after{content:"";position:absolute;left:0;right:0;height:8px;background:#2b1a13}.shelf-wood:before{top:110px}.shelf-wood:after{bottom:0}
.shelf-row{height:96px;display:flex;align-items:flex-end;gap:6px;padding:0 2px 8px;overflow:hidden}
.book{width:22px;border-radius:3px 3px 0 0;display:flex;align-items:flex-end;justify-content:center;color:rgba(255,255,255,.96);font-size:8px;font-weight:700;padding:6px 2px 8px;box-shadow:inset 4px 0 rgba(255,255,255,.18);writing-mode:vertical-rl;text-orientation:mixed;letter-spacing:.5px;position:relative}
.book.small{height:38px}.book.mid{height:62px}.book.tall{height:83px}.book.lean{transform:rotate(-6deg);transform-origin:bottom center}.slot{width:22px;height:84px;border:2px dashed rgba(255,255,255,.2);border-radius:4px;opacity:.35}
.genre-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.genre-card{background:#efe6d6;border:2px solid rgba(0,0,0,.12);border-radius:10px;padding:8px;text-align:center;font-size:11px;position:relative}.genre-card.active{outline:3px solid #d7b24e}.genre-card .gicon{font-size:18px;display:block}.genre-card strong{display:block;font-size:12px;margin-top:4px}.genre-card small{display:block;color:var(--muted)}
.card{background:#fffdf8;border:2px solid rgba(0,0,0,.12);border-radius:12px;padding:10px;margin-bottom:10px}
.row{display:flex;gap:8px;align-items:center}.row.wrap{flex-wrap:wrap}.space{justify-content:space-between}.muted{color:var(--muted)}
.action-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.list{display:grid;gap:8px}.item{background:#fffdf8;border:2px solid rgba(0,0,0,.12);border-radius:12px;padding:10px;display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center}.item .big{width:36px;height:36px;border-radius:10px;background:#f1e7d8;display:grid;place-items:center;font-size:18px;border:2px solid rgba(0,0,0,.1)}
.item b{display:block;font-size:13px}.item small{display:block;color:var(--muted);line-height:1.45}.tiny{font-size:11px}.money{font-weight:800;color:#5a7b4e}
.meter{height:10px;border-radius:999px;background:#e8dece;border:1px solid rgba(0,0,0,.1);overflow:hidden}.meter>div{height:100%;background:linear-gradient(90deg,#95b485,#e1b360)}
.bottom-bar{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.modal{position:fixed;inset:0;background:rgba(34,26,22,.42);backdrop-filter:blur(5px);display:none;align-items:center;justify-content:center;padding:16px;z-index:60}.modal.show{display:flex}.sheet{width:min(100%,410px);max-height:88vh;overflow:auto;background:#fbf6ee;border:2px solid var(--line);border-radius:18px;padding:14px;box-shadow:var(--shadow)}
.sheet h3{margin:0 0 8px;font:normal 24px Georgia,serif}.sheet p{line-height:1.55}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.field label{display:block;font-size:12px;font-weight:700;margin-bottom:4px}.field input,.field select{width:100%;min-height:42px;border:2px solid rgba(0,0,0,.16);border-radius:12px;background:#fffefb;padding:9px 11px}
.avatar-card{display:grid;grid-template-columns:100px 1fr;gap:10px;align-items:center}
.preview{height:145px;border-radius:16px;background:linear-gradient(#f4e7d7,#fbf6ed);border:2px solid rgba(0,0,0,.1);display:grid;place-items:center;position:relative;overflow:hidden}
.preview:before{content:"";position:absolute;left:20px;right:20px;bottom:12px;height:14px;border-radius:50%;background:rgba(77,57,44,.1)}
.map-city{padding:9px 10px;border-radius:12px;background:#fffdf8;border:2px solid rgba(0,0,0,.12);margin-bottom:8px}.map-city.current{border-color:#d1af57;background:#fcf2dc}
.log{padding:8px 0;border-bottom:1px dashed rgba(0,0,0,.14);font-size:13px}.log:last-child{border-bottom:0}
</style>
</head>
<body>
<div id="app">
  <div id="intro" class="intro">
    <img src="./title_art.png" alt="Xuân Hạ Thu Đông">
    <div class="intro-card">
      <h1>Xuân Hạ Thu Đông</h1>
      <p>Đi qua bốn mùa và mười thành phố bằng một xe sách lưu động. Khách sẽ bước đến trước tiệm, bạn chỉ cần chạm để phục vụ. Tích tiền để mở thêm xe, thời trang và trang trí.</p>
      <div class="stack">
        <button class="primary" id="btnNew">🌷 Chơi mới</button>
        <button class="soft" id="btnContinue">📖 Tiếp tục</button>
        <button class="ghost" id="btnHow">✨ Cách chơi</button>
      </div>
    </div>
  </div>

  <div class="top">
    <div class="status-row">
      <div class="box blue" id="dayBox"></div>
      <div class="box"><span>🪙</span><strong id="moneyBox"></strong></div>
      <div class="box"><span>❤️</span><strong id="heartBox"></strong></div>
      <div class="row" style="justify-content:flex-end;gap:8px">
        <button class="icon-round" id="btnJournal">📒<span class="badge-dot"></span></button>
        <button class="icon-round" id="btnSettings">⚙️</button>
      </div>
    </div>
    <div class="city-btn">
      <button class="box" id="btnMap">🗺️ Bản đồ</button>
      <button class="icon-round" id="btnSound">🔈</button>
    </div>
  </div>

  <div class="scene" id="scene">
    <div class="scene-bg"></div>
    <div id="seasonWash" class="scene-overlay season-wash spring"></div>
    <div class="floaters" id="floaters"></div>
    <div class="stage-pill" id="cityPill"></div>
    <div class="stage-pill right" id="eventPill"></div>
    <div class="truck-zone">
      <div id="truckSvg"></div>
      <div class="walk-layer" id="walkLayer"></div>
    </div>
    <div id="toast" class="toast hidden"></div>
  </div>

  <div class="tabs" id="tabs"></div>
  <div class="panel" id="panel"></div>
</div>

<div id="modal" class="modal"><div class="sheet" id="sheet"></div></div>

<script>
const STORAGE='xuan_ha_thu_dong_mobile_v1';
const genres=[
{id:'detective',name:'Trinh thám',icon:'🔎',color:'#6c77af',price:36,short:'Trinh t…'},
{id:'drama',name:'Kịch tính',icon:'🎭',color:'#b05b58',price:34,short:'Kịch t…'},
{id:'science',name:'Khoa học',icon:'🔬',color:'#7ca767',price:37,short:'Khoa h…'},
{id:'fantasy',name:'Kỳ ảo',icon:'🌙',color:'#8f78b1',price:35,short:'Kỳ ảo'},
{id:'classic',name:'Kinh điển',icon:'📜',color:'#cba860',price:33,short:'Kinh…'},
{id:'children',name:'Thiếu nhi',icon:'🧸',color:'#86a56a',price:28,short:'Thiếu…'},
{id:'travel',name:'Du lịch',icon:'🧭',color:'#cf8a5e',price:32,short:'Du lịch'},
{id:'romance',name:'Lãng mạn',icon:'🌷',color:'#c47f8d',price:34,short:'Lãng…'}
];
const seasons=[
{id:'spring',name:'Xuân',emoji:'🌸',boost:['romance','children'],particle:'✿'},
{id:'summer',name:'Hạ',emoji:'☀️',boost:['travel','fantasy'],particle:'❀'},
{id:'autumn',name:'Thu',emoji:'🍁',boost:['detective','classic'],particle:'❋'},
{id:'winter',name:'Đông',emoji:'❄️',boost:['science','romance'],particle:'•'}
];
const cities=[
{name:'Phố Gió',event:'Ngày Hoa Giấy',desc:'Khách thích những cuốn sách dịu dàng và dễ thương.',boost:['romance','children'],sound:'chime'},
{name:'Bến Biển',event:'Tuần Du Ngoạn',desc:'Khách hỏi nhiều về du lịch và chuyến đi.',boost:['travel','classic'],sound:'wave'},
{name:'Đồi Cối Xay',event:'Chợ Tri Thức',desc:'Nhiều gia đình tìm sách khoa học.',boost:['science'],sound:'wind'},
{name:'Vườn Lam',event:'Giờ Kể Chuyện',desc:'Sách thiếu nhi bán rất tốt.',boost:['children'],sound:'birds'},
{name:'Cầu Mây',event:'Đêm Đèn Sao',desc:'Không khí mộng mơ khiến sách kỳ ảo hút khách.',boost:['fantasy','romance'],sound:'bell'},
{name:'Phố Đèn',event:'Lễ Hội Lồng Đèn',desc:'Khách trẻ mê truyện lãng mạn và kỳ ảo.',boost:['romance','fantasy'],sound:'chime'},
{name:'Bãi Sương',event:'Sớm Mai Êm',desc:'Khách tìm sách kinh điển và chữa lành.',boost:['classic'],sound:'wind'},
{name:'Hẻm Chuông',event:'Truy Tìm Bí Ẩn',desc:'Trinh thám là thể loại được hỏi nhiều nhất.',boost:['detective'],sound:'bell'},
{name:'Tháp Đồng Hồ',event:'Ngày Hẹn Hò',desc:'Lãng mạn và kịch tính đều đông khách.',boost:['romance','drama'],sound:'clock'},
{name:'Hồ Trăng',event:'Phiên Chợ Cuối Tuần',desc:'Sách du lịch, thiếu nhi và các bộ dễ đọc được yêu thích.',boost:['travel','children'],sound:'birds'}
];
const decorations=[
{id:'flowers',name:'Hoa đầu xe',icon:'💐',cost:100,desc:'Boa tiền tăng nhẹ.'},
{id:'awning',name:'Mái hiên sọc',icon:'⛱️',cost:160,desc:'Khách đến nhanh hơn.'},
{id:'lantern',name:'Đèn lồng',icon:'🏮',cost:150,desc:'Tăng tim yêu mến khi phục vụ.'},
{id:'cat',name:'Mèo nằm cửa kính',icon:'🐈',cost:220,desc:'Có cơ hội nhận thêm boa.'},
{id:'pennants',name:'Dây cờ',icon:'🎏',cost:175,desc:'Không khí sự kiện đẹp hơn.'}
];
const truckStyles=[
{id:'classic',name:'Xe cổ xanh lá',level:1,body:'#8ba787',trim:'#e5d4bb',roof:'#c98359'},
{id:'cream',name:'Xe kem bơ',level:2,body:'#d9c29f',trim:'#f6efe0',roof:'#9f7f67'},
{id:'lavender',name:'Xe oải hương',level:3,body:'#b39cc6',trim:'#efe8f5',roof:'#d08d86'},
{id:'blue',name:'Xe xanh hải quân',level:4,body:'#6f89b3',trim:'#e6eef7',roof:'#cf9b68'},
{id:'night',name:'Xe đêm sao',level:5,body:'#4e627e',trim:'#ede7dd',roof:'#b96f73'}
];
const wardrobe={
 hair:[{id:'short',name:'Tóc ngắn',cost:0},{id:'bob',name:'Tóc bob',cost:90},{id:'wave',name:'Tóc gợn',cost:120},{id:'bun',name:'Tóc búi',cost:135},{id:'braid',name:'Tóc tết',cost:150}],
 outfit:[{id:'apron',name:'Tạp dề sách',cost:0},{id:'lilac',name:'Váy oải hương',cost:130},{id:'sage',name:'Áo len xanh xô thơm',cost:150},{id:'sailor',name:'Bộ thủy thủ',cost:165},{id:'coat',name:'Áo khoác mùa đông',cost:180}],
 hairColor:[{id:'brown',name:'Nâu hạt dẻ',cost:0,color:'#6b4f40'},{id:'black',name:'Đen mềm',cost:70,color:'#322927'},{id:'gold',name:'Vàng mật',cost:90,color:'#c48f59'},{id:'rose',name:'Hồng trà',cost:95,color:'#a56e6e'},{id:'silver',name:'Bạc mây',cost:110,color:'#c0c2c8'}]
};
const customerNames=['An','Linh','Mây','Bảo','Minh','Nhi','Lam','Trà','Hạ','Thu','Đông','Hà','Phong','Vy','Khôi','Mộc'];
const requestLines={
detective:['Mình đang tìm một cuốn có bí ẩn để đoán đến cuối.','Cho mình một cuốn trinh thám thật cuốn nhé.'],
drama:['Mình muốn một câu chuyện kịch tính một chút.','Có cuốn nào dồn dập cảm xúc không?'],
science:['Mình cần một cuốn giúp mình hiểu thêm điều mới.','Cho mình sách khoa học dễ đọc nhé.'],
fantasy:['Mình muốn một thế giới có phép màu.','Có cuốn kỳ ảo nào đẹp và mơ không?'],
classic:['Mình muốn đọc một cuốn thật kinh điển.','Cho mình thử một tác phẩm ai cũng nên đọc.'],
children:['Mình tìm quà cho một bạn nhỏ.','Có cuốn nào thật đáng yêu cho trẻ con không?'],
travel:['Mình muốn đọc về chuyến đi và những nơi xa.','Cho mình một cuốn để mang theo du lịch nhé.'],
romance:['Mình đang muốn đọc một chuyện ấm lòng.','Có cuốn nào làm tim rung lên không?']
};
function genreById(id){return genres.find(g=>g.id===id)}
function seasonForDay(day){return seasons[Math.floor((day-1)/5)%4]}
function cityForDay(day){return cities[(day-1)%cities.length]}
function price(v){return Math.round(v).toLocaleString('vi-VN')+'đ'}
function clamp(v,a,b){return Math.max(a,Math.min(b,v))}
function makeInventory(n){const o={};genres.forEach(g=>o[g.id]=n);return o}
function state0(){return {setup:false,owner:'Mây',shop:'Sách Gió',day:1,money:650000,hearts:1,level:1,xp:0,tab:'shelf',sound:false,
  selectedGenre:'detective',storage:makeInventory(6),shelf:makeInventory(2),shelfCap:45,storageCap:160,
  decor:['flowers'],truckStyle:'classic',unlockedStyles:['classic'],wardrobe:{hair:'short',outfit:'apron',hairColor:'brown'},
  owned:{hair:['short'],outfit:['apron'],hairColor:['brown']},open:false,served:0,targetCustomers:8,logs:['Hành trình xe sách vừa bắt đầu.'],seen:true};}
let S=load();
function load(){try{const s=JSON.parse(localStorage.getItem(STORAGE)); if(s) return Object.assign(state0(),s);}catch(e){} return state0();}
function save(){localStorage.setItem(STORAGE,JSON.stringify(S));}
let toastTimer=null, modal=document.getElementById('modal'), sheet=document.getElementById('sheet');
let customers=[], customerId=1, spawnClock=0, lastT=0, ambientCtx=null, ambientNodes=[], ambientTimer=null;
function showToast(msg){const t=document.getElementById('toast'); t.textContent=msg; t.classList.remove('hidden'); clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.add('hidden'),2200);}
function pushLog(msg){S.logs.unshift('Ngày '+S.day+': '+msg); S.logs=S.logs.slice(0,40); save();}
function levelNeeds(lv){return lv*6}
function totalShelf(){return Object.values(S.shelf).reduce((a,b)=>a+b,0)}
function totalStorage(){return Object.values(S.storage).reduce((a,b)=>a+b,0)}
function boostsToday(){const season=seasonForDay(S.day), city=cityForDay(S.day); return [...new Set([...season.boost,...city.boost])];}
function unlockTruckStyles(){truckStyles.forEach(s=>{if(S.level>=s.level && !S.unlockedStyles.includes(s.id)) S.unlockedStyles.push(s.id);});}
function currentTruck(){return truckStyles.find(x=>x.id===S.truckStyle) || truckStyles[0]}
function maybeLevelUp(){let changed=false; while(S.xp>=levelNeeds(S.level)){S.xp-=levelNeeds(S.level); S.level++; changed=true; pushLog('Lên cấp '+S.level+', mở thêm kiểu xe mới.');} if(changed){unlockTruckStyles(); showToast('✨ Lên cấp! Hiện tại cấp '+S.level);}}
function saleValue(genre){let base=(genreById(genre).price*1000); if(boostsToday().includes(genre)) base+=4000; if(S.decor.includes('cat')) base+=1000; return base;}
function spawnCustomer(){if(!S.open) return; const likes=boostsToday(); const pref=(Math.random()<.7?likes[Math.floor(Math.random()*likes.length)]:genres[Math.floor(Math.random()*genres.length)].id); const side=Math.random()<.5?'left':'right'; const targetX=204+Math.random()*24; const startX=side==='left'?-26:430; customers.push({id:customerId++,x:startX,y: side==='left'?238+Math.random()*6:240+Math.random()*8,targetX,side,state:'walk',genre:pref,name:customerNames[Math.floor(Math.random()*customerNames.length)],message:requestLines[pref][Math.floor(Math.random()*requestLines[pref].length)],tip:false}); }
function serveCustomer(id){const c=customers.find(x=>x.id===id); if(!c||c.state!=='wait') return; const preferred=[c.genre]; const available=preferred.find(g=>S.shelf[g]>0) || boostsToday().find(g=>S.shelf[g]>0) || Object.keys(S.shelf).find(g=>S.shelf[g]>0);
 if(!available){c.state='leave'; c.vx = c.side==='left'?-38:38; S.hearts=Math.max(0,S.hearts-1); pushLog(c.name+' đến nhưng trên kệ không còn sách phù hợp.'); showToast('Không còn sách phù hợp trên kệ.'); render(); return;}
 S.shelf[available]--; let cash=saleValue(available); if(S.decor.includes('flowers') && Math.random()<.35) cash += 2000; if(S.decor.includes('lantern')) S.hearts += 1; if(S.decor.includes('cat') && Math.random()<.25) cash += 3000; S.money += cash; S.served++; S.xp += boostsToday().includes(available)?2:1; maybeLevelUp(); pushLog(c.name+' mua '+genreById(available).name.toLowerCase()+'.'); showToast('Bán thành công '+genreById(available).name+' · +'+price(cash)); c.state='leave'; c.vx = c.side==='left'?-40:40; if(S.served>=S.targetCustomers) endDay(); save(); render(); }
function endDay(){S.open=false; stopAmbientPattern(); render(); openSummary();}
function startDay(){S.open=true; S.served=0; S.targetCustomers=8+Math.min(4,Math.floor(S.level/2)); customers=[]; spawnClock=0; pushLog('Mở quán tại '+cityForDay(S.day).name+'.'); render(); if(S.sound) startAmbient();}
function nextDay(){S.day++; S.open=false; S.served=0; customers=[]; pushLog('Di chuyển đến '+cityForDay(S.day).name+'.'); render(); openDayIntro();}
function buyToStorage(id,qty){const cap=S.storageCap-totalStorage(); if(cap<qty){showToast('Kho không đủ chỗ.'); return;} const cost=genreById(id).price*500*qty; if(S.money<cost){showToast('Không đủ tiền.'); return;} S.money-=cost; S.storage[id]+=qty; pushLog('Nhập thêm '+qty+' sách '+genreById(id).name.toLowerCase()+'.'); save(); render();}
function moveToShelf(id,qty){const can=Math.min(qty,S.storage[id],S.shelfCap-totalShelf()); if(can<=0){showToast('Không thể đưa thêm lên kệ.'); return;} S.storage[id]-=can; S.shelf[id]+=can; save(); render();}
function returnToStorage(id,qty){const can=Math.min(qty,S.shelf[id]); if(can<=0) return; if(totalStorage()+can>S.storageCap){showToast('Kho đầy.'); return;} S.shelf[id]-=can; S.storage[id]+=can; save(); render();}
function buyDecoration(id){const d=decorations.find(x=>x.id===id); if(S.decor.includes(id)){showToast('Bạn đã có món này.'); return;} if(S.money<d.cost*1000){showToast('Không đủ tiền.'); return;} S.money-=d.cost*1000; S.decor.push(id); pushLog('Mua trang trí '+d.name.toLowerCase()+'.'); save(); render();}
function buyWard(type,id){if(S.owned[type].includes(id)){S.wardrobe[type]=id; save(); render(); return;} const list=wardrobe[type]; const item=list.find(x=>x.id===id); if(S.money<item.cost*1000){showToast('Không đủ tiền.'); return;} S.money-=item.cost*1000; S.owned[type].push(id); S.wardrobe[type]=id; pushLog('Mở khóa '+item.name+'.'); save(); render();}
function selectTruck(id){if(!S.unlockedStyles.includes(id)){showToast('Chưa mở khóa kiểu xe này.'); return;} S.truckStyle=id; save(); render();}
function openModal(html){sheet.innerHTML=html; modal.classList.add('show');}
function closeModal(){modal.classList.remove('show');}
modal.addEventListener('click',e=>{if(e.target===modal) closeModal();});
function avatarSvg(scale=1){const hairColor=(wardrobe.hairColor.find(x=>x.id===S.wardrobe.hairColor)||wardrobe.hairColor[0]).color; const outfit=S.wardrobe.outfit; const colors={apron:['#dccdbd','#faf5ec','#7d97a4'],lilac:['#bea2cb','#efe7f5','#8b7197'],sage:['#9db39a','#eef3ec','#677d64'],sailor:['#7f97bd','#f7f7fa','#657a98'],coat:['#b99a8d','#f4ede8','#8d6b5f']}[outfit]||['#dccdbd','#faf5ec','#7d97a4'];
 const hairPath=S.wardrobe.hair==='bob'?`<path d="M24 35q5-22 27-22 22 0 28 20-1 13-5 22H29q-7-10-5-20Z" fill="${hairColor}"/>`:S.wardrobe.hair==='wave'?`<path d="M24 35q5-22 27-22 24 0 29 22-3 10-6 17-3 8-1 22H27q2-15-2-22-5-8-1-17Z" fill="${hairColor}"/>`:S.wardrobe.hair==='bun'?`<circle cx="68" cy="15" r="9" fill="${hairColor}"/><path d="M24 35q5-22 27-22 24 0 29 22-2 11-6 20H30q-5-10-6-20Z" fill="${hairColor}"/>`:S.wardrobe.hair==='braid'?`<path d="M24 35q5-22 27-22 24 0 29 22-2 10-6 20H30q-5-10-6-20Z" fill="${hairColor}"/><path d="M71 56q7 14 4 34" stroke="${hairColor}" stroke-width="7" stroke-linecap="round"/>`:`<path d="M24 35q5-22 27-22 24 0 29 22-2 11-6 20H30q-5-10-6-20Z" fill="${hairColor}"/>`;
 return `<svg viewBox="0 0 100 160" width="${100*scale}" height="${160*scale}"><ellipse cx="50" cy="147" rx="24" ry="7" fill="rgba(69,55,46,.12)"/>${hairPath}<circle cx="50" cy="42" r="17" fill="#efd0b8"/><circle cx="44" cy="40" r="1.4" fill="#56463d"/><circle cx="56" cy="40" r="1.4" fill="#56463d"/><path d="M45 47q5 4 10 0" stroke="#b47f77" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M36 59l-7 25M64 59l7 25" stroke="#efd0b8" stroke-width="7" stroke-linecap="round"/><path d="M31 59q18-7 38 0l6 58q-11 11-25 11-13 0-25-11Z" fill="${colors[0]}"/><path d="M37 65h26v49H37Z" fill="${colors[1]}" opacity=".95"/><path d="M44 65q6 8 12 0" stroke="${colors[2]}" stroke-width="3"/><path d="M43 117l-7 26M57 117l7 26" stroke="#6e5e55" stroke-width="7" stroke-linecap="round"/></svg>`;}
function customerSvg(c){const colors=['#a798c1','#c79ca8','#9db59c','#c8a57c','#88a2c3']; const dress=colors[c.id%colors.length]; return `<svg viewBox="0 0 44 92" width="44" height="92"><ellipse cx="22" cy="84" rx="12" ry="4" fill="rgba(71,55,48,.13)"/><path d="M16 57l-3 21M28 57l3 21" stroke="#6d5f58" stroke-width="5" stroke-linecap="round"/><path d="M10 30q11-9 24 0l5 31q-7 8-17 8-10 0-17-8Z" fill="${dress}"/><path d="M16 28l-5 16M28 28l5 16" stroke="#efceb5" stroke-width="5" stroke-linecap="round"/><circle cx="22" cy="18" r="10" fill="#efceb5"/><path d="M12 18q2-15 11-15 15-1 14 15-6-4-10-9-6 9-15 9" fill="#5f4a3e"/></svg>`;}
function truckSvg(){const t=currentTruck(); const has=x=>S.decor.includes(x); const flowers=has('flowers')?`<path d="M46 31q25-17 66-6 14 4 33 6" stroke="#cf91a4" stroke-width="6" fill="none" stroke-linecap="round"/><circle cx="67" cy="25" r="4" fill="#efc18f"/><circle cx="92" cy="28" r="4" fill="#f5dce4"/><circle cx="126" cy="31" r="4" fill="#f0cc8d"/>`:''; const flags=has('pennants')?`<path d="M56 20h75" stroke="#b78d68" stroke-width="2"/><path d="M62 20v10l8-5Z" fill="#d28f89"/><path d="M79 20v10l8-5Z" fill="#e6cb86"/><path d="M96 20v10l8-5Z" fill="#a9c1b0"/><path d="M113 20v10l8-5Z" fill="#bca6d6"/>`:''; const awning=has('awning'); const lantern=has('lantern')?`<circle cx="140" cy="39" r="6" fill="#f5cb76"/>`:''; const cat=has('cat')?`<ellipse cx="146" cy="74" rx="10" ry="7" fill="#eadfc6"/><circle cx="141" cy="73" r="1.1" fill="#6a5141"/><circle cx="147" cy="73" r="1.1" fill="#6a5141"/>`:''; return `<svg viewBox="0 0 260 132" width="100%" height="100%"><ellipse cx="126" cy="114" rx="100" ry="10" fill="rgba(84,62,48,.13)"/><path d="M34 38h112q21 0 22 18v33q0 15-16 15H45q-11 0-11-12Z" fill="${t.trim}" stroke="#b49478" stroke-width="3"/><path d="M50 24h100l11 14H39Z" fill="${t.roof}"/><path d="M43 39q10 12 20 0 10 12 20 0 10 12 20 0 10 12 20 0 10 12 20 0 10 12 20 0" stroke="${awning?'#f0e6d1':'#e4d7c5'}" stroke-width="8" fill="none" stroke-linecap="round"/>
 <rect x="48" y="47" width="78" height="44" fill="#cda685"/><path d="M48 61h78M48 75h78" stroke="#e7cfb3" stroke-width="2"/>${flowers}${flags}${lantern}
 <rect x="54" y="52" width="7" height="10" fill="#8ea7c8"/><rect x="64" y="51" width="7" height="11" fill="#d18781"/><rect x="78" y="52" width="7" height="10" fill="#a2b98e"/><rect x="91" y="52" width="7" height="10" fill="#b89bd0"/><rect x="106" y="52" width="7" height="10" fill="#d9af66"/>
 <path d="M162 50h36q18 0 24 12l11 23h-71Z" fill="${t.body}" stroke="#5e7865" stroke-width="3"/><path d="M170 55h30q12 0 18 13l4 8h-52Z" fill="#b9cacf" stroke="#e8dac8" stroke-width="3"/>${cat}
 <circle cx="67" cy="104" r="15" fill="#374650"/><circle cx="67" cy="104" r="9" fill="#ecd8b7"/><circle cx="182" cy="104" r="15" fill="#374650"/><circle cx="182" cy="104" r="9" fill="#ecd8b7"/></svg>`;}
function renderFloaters(){const season=seasonForDay(S.day); const box=document.getElementById('floaters'); box.className='floaters '+season.id; let html=''; for(let i=0;i<14;i++){html+=`<div class="floater" style="left:${Math.random()*100}%; animation-duration:${8+Math.random()*9}s; animation-delay:${-Math.random()*12}s; font-size:${11+Math.random()*8}px">${season.particle}</div>`;} box.innerHTML=html; document.getElementById('seasonWash').className='scene-overlay season-wash '+season.id; }
function renderCustomers(){const wrap=document.getElementById('walkLayer'); wrap.innerHTML=''; customers.forEach(c=>{const el=document.createElement('div'); el.className='customer '+(c.state==='wait'?'browse':''); el.style.left=c.x+'px'; el.style.top=c.y+'px'; el.innerHTML = `<div class="tap"></div>${customerSvg(c)}${c.state==='wait'?`<div class="hint">${genreById(c.genre).icon} ${genreById(c.genre).name}</div>`:''}`; if(c.state==='wait'){el.onclick=()=>serveCustomer(c.id);} wrap.appendChild(el);}); }
function renderHeader(){const season=seasonForDay(S.day); document.getElementById('dayBox').innerHTML=`<strong>${season.emoji} Ngày ${S.day} · ${season.name}</strong>`; document.getElementById('moneyBox').textContent=price(S.money); document.getElementById('heartBox').textContent=S.hearts; document.getElementById('cityPill').innerHTML=`<strong>${cityForDay(S.day).name}</strong>${cityForDay(S.day).desc}`; document.getElementById('eventPill').innerHTML=`<strong>${cityForDay(S.day).event}</strong>${S.open?'Chạm vào khách để bán sách':'Chuẩn bị mở quán'}`; }
function renderTabs(){const defs=[['shelf','Kệ sách','📚'],['decor','Trang trí','🪴'],['upgrade','Nâng cấp','🛠️'],['effect','Hiệu ứng','✨']]; document.getElementById('tabs').innerHTML=defs.map(([id,tx,ic])=>`<button class="tab ${S.tab===id?'active':''}" onclick="setTab('${id}')"><span class="ico">${ic}</span>${tx}</button>`).join(''); }
function shelfBooksArray(){const arr=[]; genres.forEach(g=>{for(let i=0;i<S.shelf[g.id];i++) arr.push({g,shape:i%3===0?'tall':i%3===1?'mid':'small',lean:i%5===0});}); return arr.slice(0,S.shelfCap);} 
function renderShelfTab(){const selected=genreById(S.selectedGenre); const books=shelfBooksArray(); let row1=books.slice(0,Math.ceil(books.length/2)), row2=books.slice(Math.ceil(books.length/2)); while(row1.length<15) row1.push(null); while(row2.length<15) row2.push(null);
 return `<div class="subhead"><h2>Kệ sách</h2><div class="chips"><div class="chip">Trên kệ ${totalShelf()}/${S.shelfCap}</div><div class="chip">Trong kho ${totalStorage()}/${S.storageCap}</div></div></div>
 <div class="shelf-box"><div class="shelf-wood"><div class="shelf-row">${row1.map(b=>b?`<div class="book ${b.shape} ${b.lean?'lean':''}" style="background:${b.g.color}">${b.g.short}</div>`:`<div class="slot"></div>`).join('')}</div><div class="shelf-row">${row2.map(b=>b?`<div class="book ${b.shape} ${b.lean?'lean':''}" style="background:${b.g.color}">${b.g.short}</div>`:`<div class="slot"></div>`).join('')}</div></div></div>
 <div class="genre-grid">${genres.map(g=>`<button class="genre-card ${S.selectedGenre===g.id?'active':''}" onclick="pickGenre('${g.id}')"><span class="gicon">${g.icon}</span><strong>${g.name}</strong><small>Kệ ${S.shelf[g.id]} · Kho ${S.storage[g.id]}</small></button>`).join('')}</div>
 <div class="card"><div class="row space"><div><b>${selected.icon} ${selected.name}</b><div class="tiny muted">Giá bán khoảng ${price(saleValue(selected.id))}</div></div><select onchange="pickGenre(this.value)">${genres.map(g=>`<option value="${g.id}" ${g.id===S.selectedGenre?'selected':''}>${g.name}</option>`).join('')}</select></div>
 <div class="action-row"><button class="soft" onclick="buyToStorage('${selected.id}',3)">Nhập +3</button><button class="soft" onclick="buyToStorage('${selected.id}',10)">Nhập +10</button><button class="soft" onclick="moveToShelf('${selected.id}',1)">Đưa lên kệ +1</button><button class="soft" onclick="moveToShelf('${selected.id}',5)">Đưa lên kệ +5</button><button class="soft" onclick="returnToStorage('${selected.id}',1)">Cất vào kho -1</button><button class="soft" onclick="returnToStorage('${selected.id}',5)">Cất vào kho -5</button></div></div>
 <div class="bottom-bar"><button class="soft" onclick="openMap()">← Bản đồ</button><button class="gold" ${S.open?'disabled':''} onclick="startDay()">Mở quán thôi! →</button></div>`; }
function renderDecorTab(){return `<div class="subhead"><h2>Trang trí xe</h2><div class="chip">Đã có ${S.decor.length} món</div></div><div class="card"><div class="preview">${truckSvg()}</div><div class="tiny muted">Chạm vào món để mua. Các món đã có sẽ được áp dụng ngay.</div></div><div class="list">${decorations.map(d=>`<div class="item"><div class="big">${d.icon}</div><div><b>${d.name}</b><small>${d.desc}</small></div><div>${S.decor.includes(d.id)?'<button class="soft" disabled>Đã có</button>':`<div class="money">${price(d.cost*1000)}</div><button class="soft" onclick="buyDecoration('${d.id}')">Mua</button>`}</div></div>`).join('')}</div>`;}
function renderUpgradeTab(){return `<div class="subhead"><h2>Nâng cấp</h2><div class="chip">Cấp ${S.level}</div></div><div class="card"><b>Tiến độ cấp</b><div class="meter" style="margin-top:8px"><div style="width:${(S.xp/levelNeeds(S.level))*100}%"></div></div><div class="tiny muted" style="margin-top:6px">${S.xp}/${levelNeeds(S.level)} XP để lên cấp tiếp theo</div></div><div class="card"><b>Kiểu xe bán sách</b><div class="tiny muted" style="margin:6px 0 10px">Mỗi khi lên cấp, bạn mở thêm kiểu xe mới.</div><div class="list">${truckStyles.map(t=>`<div class="item"><div class="big">🚚</div><div><b>${t.name}</b><small>Mở ở cấp ${t.level}</small></div><div>${S.unlockedStyles.includes(t.id)?`<button class="soft" onclick="selectTruck('${t.id}')">${S.truckStyle===t.id?'Đang dùng':'Dùng xe này'}</button>`:`<button class="soft" disabled>Khóa</button>`}</div></div>`).join('')}</div></div><div class="card"><b>Thời trang chủ tiệm</b><div class="avatar-card" style="margin-top:10px"><div class="preview">${avatarSvg(.8)}</div><div><div class="tiny muted">Tóc</div>${wardrobe.hair.map(x=>ownedBtn('hair',x)).join('')}<div class="tiny muted" style="margin-top:8px">Trang phục</div>${wardrobe.outfit.map(x=>ownedBtn('outfit',x)).join('')}<div class="tiny muted" style="margin-top:8px">Màu tóc</div>${wardrobe.hairColor.map(x=>ownedBtn('hairColor',x)).join('')}</div></div></div>`;}
function ownedBtn(type,item){const own=S.owned[type].includes(item.id); const active=S.wardrobe[type]===item.id; return `<div class="row space" style="margin-bottom:6px"><div class="tiny">${item.name}</div><button class="soft" style="min-height:34px;padding:8px 10px" onclick="buyWard('${type}','${item.id}')">${own?(active?'Đang dùng':'Dùng'):'Mở '+price(item.cost*1000)}</button></div>`;}
function renderEffectTab(){return `<div class="subhead"><h2>Hiệu ứng & âm thanh</h2><div class="chip">${cityForDay(S.day).name}</div></div><div class="card"><b>Âm thanh thành phố</b><p class="tiny muted">Mỗi thành phố có một không khí riêng: tiếng biển, chuông, gió, chim… Bật âm thanh để nghe.</p><div class="action-row"><button class="soft" onclick="toggleSound()">${S.sound?'Tắt âm thanh':'Bật âm thanh'}</button><button class="soft" onclick="renderFloaters()">Làm mới hiệu ứng</button></div></div><div class="card"><b>Nhật ký ngắn</b>${S.logs.slice(0,8).map(l=>`<div class="log">${l}</div>`).join('')}</div>`;}
function renderPanel(){document.getElementById('panel').innerHTML = S.tab==='shelf'?renderShelfTab():S.tab==='decor'?renderDecorTab():S.tab==='upgrade'?renderUpgradeTab():renderEffectTab();}
function renderScene(){document.getElementById('truckSvg').innerHTML=truckSvg(); renderCustomers(); renderFloaters();}
function render(){renderHeader(); renderTabs(); renderPanel(); renderScene(); document.getElementById('btnContinue').disabled=!S.setup; document.getElementById('btnSound').textContent=S.sound?'🔊':'🔈'; save();}
function openHow(){openModal(`<h3>Cách chơi</h3><p>Mỗi ngày xe sách đi đến một thành phố mới. Mùa trong năm và sự kiện thành phố sẽ làm một số thể loại sách bán tốt hơn.</p><div class="card"><b>Cách bán</b><p class="tiny muted">1) Chuẩn bị sách trong tab <b>Kệ sách</b>.<br>2) Bấm <b>Mở quán thôi!</b>.<br>3) Khách sẽ đi bộ tới quầy sách.<br>4) Chạm vào khách để phục vụ tự động bằng sách phù hợp đang có trên kệ.</p></div><div class="card"><b>Tiến triển</b><p class="tiny muted">Bán sách để kiếm tiền và XP. Lên cấp sẽ mở thêm kiểu xe, đồng thời có thể mua thêm thời trang và trang trí.</p></div><button class="primary" onclick="closeModal()">Đã hiểu</button>`);}
function openSetup(){openModal(`<h3>Tạo nhân vật</h3><div class="card avatar-card"><div class="preview" id="avatarPrev">${avatarSvg(.84)}</div><div><div class="grid2"><div class="field"><label>Tên chủ</label><input id="fOwner" value="${S.owner}"></div><div class="field"><label>Tên tiệm sách</label><input id="fShop" value="${S.shop}"></div></div><div class="field" style="margin-top:8px"><label>Tóc</label><select id="fHair">${wardrobe.hair.map(x=>`<option value="${x.id}" ${S.wardrobe.hair===x.id?'selected':''}>${x.name}</option>`).join('')}</select></div><div class="field" style="margin-top:8px"><label>Trang phục</label><select id="fOutfit">${wardrobe.outfit.map(x=>`<option value="${x.id}" ${S.wardrobe.outfit===x.id?'selected':''}>${x.name}</option>`).join('')}</select></div><div class="field" style="margin-top:8px"><label>Màu tóc</label><select id="fColor">${wardrobe.hairColor.map(x=>`<option value="${x.id}" ${S.wardrobe.hairColor===x.id?'selected':''}>${x.name}</option>`).join('')}</select></div></div></div><div class="action-row"><button class="soft" onclick="closeModal()">Đóng</button><button class="gold" id="saveSetup">Bắt đầu hành trình</button></div>`); ['fHair','fOutfit','fColor'].forEach(id=>document.getElementById(id).onchange=()=>{S.wardrobe.hair=document.getElementById('fHair').value;S.wardrobe.outfit=document.getElementById('fOutfit').value;S.wardrobe.hairColor=document.getElementById('fColor').value;document.getElementById('avatarPrev').innerHTML=avatarSvg(.84);}); document.getElementById('saveSetup').onclick=()=>{S.owner=document.getElementById('fOwner').value.trim()||'Mây';S.shop=document.getElementById('fShop').value.trim()||'Sách Gió';S.wardrobe.hair=document.getElementById('fHair').value;S.wardrobe.outfit=document.getElementById('fOutfit').value;S.wardrobe.hairColor=document.getElementById('fColor').value;S.setup=true; closeModal(); document.getElementById('intro').classList.add('hidden'); save(); render(); openDayIntro();};}
function openMap(){openModal(`<h3>Lộ trình 10 thành phố</h3><p class="tiny muted">Mỗi ngày xe sách đến một thành phố mới. Sau 10 ngày, hành trình lặp lại nhưng mùa sẽ tiếp tục thay đổi.</p>${cities.map((c,i)=>`<div class="map-city ${i===((S.day-1)%10)?'current':''}"><b>${i+1}. ${c.name}</b><div class="tiny muted">${c.event} · ${c.desc}</div></div>`).join('')}<button class="primary" onclick="closeModal()">Đóng</button>`);}
function openJournal(){openModal(`<h3>Nhật ký tiệm sách</h3><div class="card"><b>${S.shop}</b><div class="tiny muted">Chủ tiệm: ${S.owner}</div><div class="tiny muted">Cấp ${S.level} · Tiền ${price(S.money)}</div></div>${S.logs.map(l=>`<div class="log">${l}</div>`).join('')}<div class="action-row"><button class="danger" onclick="if(confirm('Bắt đầu lại từ đầu?')){localStorage.removeItem(STORAGE); location.reload();}">Chơi lại</button><button class="primary" onclick="closeModal()">Đóng</button></div>`);}
function openSettings(){openModal(`<h3>Cài đặt</h3><div class="card"><div class="row space"><b>Âm thanh</b><button class="soft" onclick="toggleSound()">${S.sound?'Tắt':'Bật'}</button></div><div class="tiny muted" style="margin-top:6px">Âm thanh sẽ đổi theo từng thành phố.</div></div><div class="card"><div class="row space"><b>Tạo lại nhân vật</b><button class="soft" onclick="closeModal();openSetup()">Chỉnh sửa</button></div></div><button class="primary" onclick="closeModal()">Xong</button>`);}
function openDayIntro(){const season=seasonForDay(S.day), city=cityForDay(S.day); openModal(`<h3>${season.emoji} Ngày ${S.day} · ${city.name}</h3><div class="card"><b>${city.event}</b><p class="tiny muted">${city.desc}</p></div><div class="card"><b>Hôm nay bán tốt</b><div class="row wrap" style="margin-top:8px">${boostsToday().map(id=>`<div class="chip">${genreById(id).icon} ${genreById(id).name}</div>`).join('')}</div></div><button class="gold" onclick="closeModal()">Đến chuẩn bị</button>`);}
function openSummary(){openModal(`<h3>Kết thúc ngày ${S.day}</h3><div class="card"><div class="row space"><b>Đã phục vụ</b><b>${S.served} khách</b></div><div class="row space"><b>Tiền hiện có</b><b>${price(S.money)}</b></div><div class="row space"><b>Cấp độ</b><b>${S.level}</b></div></div><div class="card"><b>Thành phố tiếp theo</b><div class="tiny muted">${cityForDay(S.day+1).name} · ${cityForDay(S.day+1).event}</div></div><div class="action-row"><button class="soft" onclick="closeModal()">Ở lại xem</button><button class="gold" onclick="closeModal();nextDay()">Ngày mới →</button></div>`);}
function pickGenre(id){S.selectedGenre=id; render();}
function setTab(id){S.tab=id; render();}
function toggleSound(){S.sound=!S.sound; if(S.sound) startAmbient(); else stopAmbientPattern(); render(); save();}
function startAmbient(){stopAmbientPattern(); const profile=cityForDay(S.day).sound; try{ambientCtx=ambientCtx||new (window.AudioContext||window.webkitAudioContext)(); if(ambientCtx.state==='suspended') ambientCtx.resume();}catch(e){S.sound=false; render(); return;} if(profile==='wave'){ambientWave();} else if(profile==='birds'){ambientBirds();} else if(profile==='wind'){ambientWind();} else if(profile==='bell'){ambientBell();} else if(profile==='clock'){ambientClock();} else ambientChime();}
function clearAmbient(){ambientNodes.forEach(n=>{try{n.stop&&n.stop();}catch(e){} try{n.disconnect&&n.disconnect();}catch(e){} }); ambientNodes=[]; if(ambientTimer){clearInterval(ambientTimer);ambientTimer=null;}}
function stopAmbientPattern(){clearAmbient();}
function ambientChime(){clearAmbient(); ambientTimer=setInterval(()=>tone(660,.12,.04,'sine'),2800);}
function ambientBell(){clearAmbient(); ambientTimer=setInterval(()=>{tone(620,.18,.05,'triangle'); setTimeout(()=>tone(930,.1,.03,'sine'),120);},3200);}
function ambientClock(){clearAmbient(); ambientTimer=setInterval(()=>tone(780,.08,.04,'square'),1600);}
function ambientWave(){clearAmbient(); ambientTimer=setInterval(()=>{tone(180,.45,.02,'sine'); setTimeout(()=>tone(140,.55,.02,'sine'),260);},1800);}
function ambientWind(){clearAmbient(); ambientTimer=setInterval(()=>{tone(240,.4,.015,'triangle'); setTimeout(()=>tone(190,.5,.012,'triangle'),180);},2300);}
function ambientBirds(){clearAmbient(); ambientTimer=setInterval(()=>{tone(1100,.08,.03,'sine'); setTimeout(()=>tone(980,.05,.02,'sine'),120); setTimeout(()=>tone(1260,.07,.02,'sine'),260);},2600);}
function tone(freq,dur,vol,type){if(!ambientCtx) return; const o=ambientCtx.createOscillator(), g=ambientCtx.createGain(); o.type=type; o.frequency.value=freq; g.gain.value=0.0001; o.connect(g); g.connect(ambientCtx.destination); const t=ambientCtx.currentTime; g.gain.exponentialRampToValueAtTime(vol,t+.02); g.gain.exponentialRampToValueAtTime(0.0001,t+dur); o.start(); o.stop(t+dur+.03); ambientNodes.push(o,g);}
function tick(ts){if(!lastT) lastT=ts; const dt=(ts-lastT)/1000; lastT=ts; if(S.open){spawnClock+=dt; const interval=S.decor.includes('awning')?2.6:3.4; if(spawnClock>=interval && customers.filter(c=>c.state!=='leave').length<4 && S.served< S.targetCustomers){spawnClock=0; spawnCustomer();} customers.forEach(c=>{ if(c.state==='walk'){ const speed=34; if(Math.abs(c.x-c.targetX)<=2){ c.state='wait'; } else c.x += c.x<c.targetX ? speed*dt : -speed*dt; } else if(c.state==='leave'){ c.x += c.vx*dt; }}); customers=customers.filter(c=>c.x>-60 && c.x<480); renderCustomers(); } requestAnimationFrame(tick); }
function wire(){document.getElementById('btnNew').onclick=()=>{S=state0(); save(); openSetup();}; document.getElementById('btnContinue').onclick=()=>{document.getElementById('intro').classList.add('hidden'); render(); if(!S.setup) openSetup(); else openDayIntro();}; document.getElementById('btnHow').onclick=openHow; document.getElementById('btnMap').onclick=openMap; document.getElementById('btnJournal').onclick=openJournal; document.getElementById('btnSettings').onclick=openSettings; document.getElementById('btnSound').onclick=toggleSound;}
wire(); render(); requestAnimationFrame(tick);
window.closeModal=closeModal; window.openMap=openMap; window.startDay=startDay; window.buyToStorage=buyToStorage; window.moveToShelf=moveToShelf; window.returnToStorage=returnToStorage; window.buyDecoration=buyDecoration; window.selectTruck=selectTruck; window.buyWard=buyWard; window.pickGenre=pickGenre; window.setTab=setTab; window.toggleSound=toggleSound;
</script>
</body>
</html>
